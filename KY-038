int leds[] = {2,3,4,5,6,7,8,9};
int sensorSonido=A0;
int valBase = 0;
int valSonido = valBase;
int valAnterior = valBase;

void setup() {
  Serial.begin(9600);
  for (int a = 0; a < 10; a++) {
    pinMode(leds[a], OUTPUT);
  }
  pinMode(sensorSonido, INPUT);

}

void loop() {
  valSonido = analogRead(sensorSonido);
  Serial.println(valSonido);
  valSonido = map(valSonido, 0, 1023, 0, 7);
  Serial.println(valSonido);
    for (valAnterior=0; valAnterior <= valSonido; valAnterior++){ // Encender Leds hasta el valor actual de sonido
      digitalWrite(leds[valAnterior], HIGH);
  }
    for (valAnterior=9; valAnterior > valSonido; valAnterior--){  // Apagar leds mayores al valor del Sonido
      digitalWrite(leds[valAnterior], LOW);
  }
  delay(100);
}
